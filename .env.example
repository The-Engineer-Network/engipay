# Copy to .env.local for the web app. .env.local is git-ignored.
# Every value here is public (NEXT_PUBLIC_*): it ships to the browser. Never put a secret in this file.

# testnet (default): Base Sepolia and Stellar Testnet. mainnet: Base and Stellar with real money.
NEXT_PUBLIC_CHAIN_ENV=testnet

# From https://cloud.reown.com. Without it, browser wallets still connect; mobile wallets over WalletConnect do not.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. Defaults to the Stellar Development Foundation's public Horizon for the network above.
NEXT_PUBLIC_STELLAR_HORIZON_URL=
