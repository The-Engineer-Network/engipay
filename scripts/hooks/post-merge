#!/usr/bin/env sh
# post-merge — warn after pulling if the merge introduced supply-chain patterns.
#
# Install: git config core.hooksPath scripts/hooks
#
# This hook fires after `git merge` and `git pull`. It scans files changed by
# the merge for the same markers as the CI scan-config job.
#
# Works on macOS, Linux and Git Bash on Windows.

set -eu

WARN_COLOR='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

OBFUS_PATTERNS="global\.i[[:space:]]*= _0x[0-9a-fA-F]{4,}"
CONFIG_PATTERNS="postcss.config.* next.config.* tailwind.config.* \
  .eslintrc.* babel.config.* vite.config.* jest.config.* webpack.config.*"

FOUND=0

# Files changed in the merge (ORIG_HEAD is set by git before the merge)
CHANGED=$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null || true)
[ -z "$CHANGED" ] && exit 0

for file in $CHANGED; do
  [ -f "$file" ] || continue

  # Long lines in config files
  MATCH=0
  for pat in $CONFIG_PATTERNS; do
    case "$file" in
      $pat) MATCH=1; break ;;
      */$pat) MATCH=1; break ;;
    esac
  done

  if [ "$MATCH" -eq 1 ]; then
    while IFS= read -r line; do
      len=${#line}
      if [ "$len" -gt 1000 ]; then
        printf "${RED}WARNING${NC}: $file has a line of $len chars after merge.\n" >&2
        printf "         This matches the supply-chain attack pattern. Review before running anything.\n" >&2
        FOUND=1
      fi
    done < "$file"
  fi

  # Obfuscation markers in JS/TS
  case "$file" in
    *.js|*.mjs|*.cjs|*.ts|*.tsx)
      for pat in $OBFUS_PATTERNS; do
        if grep -qE "$pat" "$file" 2>/dev/null; then
          printf "${RED}WARNING${NC}: $file contains obfuscation marker after merge: $pat\n" >&2
          FOUND=1
        fi
      done
      ;;
  esac
done

if [ "$FOUND" -ne 0 ]; then
  printf "\n${WARN_COLOR}post-merge: suspicious patterns detected in merged files.${NC}\n" >&2
  printf "Do not run npm install or builds until you have reviewed the changes above.\n" >&2
  printf "Consider running: git log --stat ORIG_HEAD..HEAD\n" >&2
fi
