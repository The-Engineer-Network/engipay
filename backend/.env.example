# Copy to backend/.env and fill in. backend/.env is git-ignored and must never be committed.

# Pick a long random value; this is only for the local database.
POSTGRES_USER=engipay
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=engipay

# Browser origins allowed to call the API, comma separated.
ALLOWED_ORIGINS=http://localhost:3000

# --- Secrets ---
# Selects the secrets backend. `local` uses files and environment variables.
# Other values fail fast so a misconfigured production deployment does not
# silently fall back to env vars.
SECRETS_BACKEND=local

# Required. Signs and verifies session JWTs (HMAC-SHA256). Pick a long random
# value and never reuse it across environments.
# The value may also be supplied as a file via JWT_SECRET_FILE, which is
# preferred in containers.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Set to a new JWT secret to rotate the signing key at startup.
# The old key remains accepted for verification for JWT_ROTATION_OVERLAP_SECONDS
# so existing sessions keep working until they expire.
JWT_SECRET_NEXT=

# Optional. How long the previous JWT key is accepted after a rotation.
# Defaults to the session lifetime (86400 seconds).
JWT_ROTATION_OVERLAP_SECONDS=

# The server's Stellar signing key (S...), used to co-sign SEP-10 challenge
# transactions. Leave empty to skip Stellar wallet auth.
STELLAR_SERVER_SECRET=

# --- Stellar (engipay-chain) ---
# testnet or mainnet. Anything else is refused.
STELLAR_NETWORK=testnet
# Optional. Defaults to the Stellar Development Foundation's public Horizon.
STELLAR_HORIZON_URL=
# The custody account deposits arrive in (a plain G... address). Users get
# muxed M... addresses derived from it. Leave empty to skip Stellar.
STELLAR_CUSTODY_ACCOUNT=
# Optional: ledger to start watching from. Defaults to the latest ledger.
STELLAR_START_LEDGER=
# Only for `engipay-chain stellar-send`, and refused unless STELLAR_NETWORK=testnet.
# Never put a mainnet key here: production signing goes through a KMS.
STELLAR_TESTNET_SECRET=

# --- Base (engipay-chain) ---
# mainnet or sepolia. Anything else is refused. Defaults to sepolia, so set
# mainnet explicitly in production.
BASE_NETWORK=
# The Base JSON-RPC endpoint the deposit watcher polls for USDC currency transfers.
# This and BASE_CUSTODY_ADDRESS must both be set (or both left empty) to watch
# Base; half-configuration refuses to start.
BASE_RPC_URL=
# The custody address deposits arrive in (a plain 0x... address).
BASE_CUSTODY_ADDRESS=
# Optional: block to start watching from. Defaults to the last block recorded
# in chain_cursors, or the latest block on a first run.
BASE_START_BLOCK=
# Optional: seconds between polls. Defaults to 5.
BASE_POLL_SECONDS=
