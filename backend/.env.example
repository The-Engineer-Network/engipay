# Copy to backend/.env and fill in. backend/.env is git-ignored and must never be committed.

# Pick a long random value; this is only for the local database.
POSTGRES_USER=engipay
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=engipay

# Browser origins allowed to call the API, comma separated.
ALLOWED_ORIGINS=http://localhost:3000

# Required. Signs and verifies session JWTs (HMAC-SHA256). Pick a long random
# value and never reuse it across environments.
JWT_SECRET=change-me-to-a-long-random-string

# The server's Stellar signing key (S...), used to co-sign SEP-10 challenge
# transactions. Leave empty to skip Stellar wallet auth.
STELLAR_SERVER_SECRET=

# --- Stellar (engipay-chain) ---
# testnet or mainnet. Anything else is refused.
STELLAR_NETWORK=testnet
# Optional. Defaults to the Stellar Development Foundation's public Horizon.
STELLAR_HORIZON_URL=
# Optional. Stellar RPC endpoint for Soroban contract events (getEvents).
# Defaults to the SDF's public Soroban RPC for the configured network.
STELLAR_RPC_URL=
# The custody account deposits arrive in (a plain G... address). Users get
# muxed M... addresses derived from it. Leave empty to skip Stellar.
STELLAR_CUSTODY_ACCOUNT=
# Optional: ledger to start watching from. Defaults to the latest ledger.
STELLAR_START_LEDGER=
# Only for `engipay-chain stellar-send`, and refused unless STELLAR_NETWORK=testnet.
# Never put a mainnet key here: production signing goes through a KMS.
STELLAR_TESTNET_SECRET=

# --- Stellar Anchor (SEP-24) ---
# Base URL of the SEP-24 anchor server, e.g. https://testanchor.stellar.org
STELLAR_ANCHOR_URL=
# Home domain of the anchor, used for SEP-10 authentication.
STELLAR_ANCHOR_HOME_DOMAIN=

# --- Read replica (optional) ---
# Database URL for read queries. If empty, reads use the primary POSTGRES_* connection.
REPLICA_DATABASE_URL=

# --- Withdrawal review ---
# Withdrawals above this amount (in USDC, as an integer) require manual approval. Defaults to 1000.
WITHDRAWAL_REVIEW_THRESHOLD_USDC=1000

# --- Reconciliation ---
# How often to reconcile ledger balances with chain state, in seconds. Defaults to 3600 (1 hour).
RECONCILE_INTERVAL_SECONDS=3600
# Surplus tolerance in smallest units. Mismatches within this amount do not raise alerts. Defaults to 1000000 (1 USDC).
RECONCILE_SURPLUS_TOLERANCE=1000000

# --- Buy/convert pricing ---
# Fee charged on buy orders, in basis points (100 bps = 1%). Defaults to 50 (0.5%).
BUY_FEE_BPS=50
# Naira price per USDC in kobo (smallest Naira unit). Example: 150000 means 1500 NGN per USDC.
BUY_KOBO_PER_USDC=150000

# --- Bitcoin ---
# Esplora API URL for Bitcoin. Use https://blockstream.info/testnet/api for testnet.
BITCOIN_ESPLORA_URL=https://blockstream.info/testnet/api

# --- Internal authentication ---
# Shared secret for chain service internal API calls. Pick a long random value.
CHAIN_INTERNAL_TOKEN=change-me-to-a-long-random-string

# --- Logging ---
# Log output format: json or pretty. Defaults to pretty.
LOG_FORMAT=pretty

# --- Base (engipay-chain) ---
# mainnet or sepolia. Anything else is refused. Defaults to sepolia, so set
# mainnet explicitly in production.
BASE_NETWORK=
# The Base JSON-RPC endpoint the deposit watcher polls for USDC transfers.
# This and BASE_CUSTODY_ADDRESS must both be set (or both left empty) to watch
# Base; half-configuration refuses to start.
BASE_RPC_URL=
# The custody address deposits arrive in (a plain 0x... address).
BASE_CUSTODY_ADDRESS=
# Optional: block to start watching from. Defaults to the last block recorded
# in chain_cursors, or the latest block on a first run.
BASE_START_BLOCK=
# Optional: seconds between polls. Defaults to 5.
BASE_POLL_SECONDS=

# --- Receipt signing (Ed25519) ---
# Identifies the key currently used to sign transaction receipts. Rotation
# means bumping this to a new id and adding the old key to RECEIPT_PUBLIC_KEYS.
RECEIPT_SIGNING_KEY_ID=
# The Ed25519 secret used to sign receipts, base64 or hex encoded. Pick a long
# random value and never commit it or reuse it across environments.
RECEIPT_SIGNING_KEY=
# Comma-separated `keyid:base64pubkey` list of historical public keys, kept so
# receipts signed before a rotation still verify. The current key's public half
# is published automatically; list older keys here.
RECEIPT_PUBLIC_KEYS=
