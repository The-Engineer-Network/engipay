# Copy to backend/.env and fill in. backend/.env is git-ignored and must never be committed.

# ── Postgres ──────────────────────────────────────────────────────────────────
# Pick a long random value; this is only for the local database.
POSTGRES_USER=engipay
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=engipay

# Full DSN used by the API and chain services. Constructed from the vars above
# in docker-compose.yml; override it directly if you connect to a remote DB.
# DATABASE_URL=postgres://engipay:change-me@localhost:5432/engipay

# ── API service (engipay-api) ──────────────────────────────────────────────────
# Address and port the API listens on. Defaults to 0.0.0.0:8080.
BIND_ADDR=0.0.0.0:8080

# Browser origins allowed to call the API, comma separated.
ALLOWED_ORIGINS=http://localhost:3000

# Maximum number of Postgres connections in the pool. Defaults to 10.
DB_MAX_CONNECTIONS=10

# Log format: "json" for structured JSON (recommended in production),
# anything else for human-readable text. Defaults to text.
LOG_FORMAT=text

# Required. Signs and verifies session JWTs (HMAC-SHA256). Pick a long random
# value and never reuse it across environments.
JWT_SECRET=change-me-to-a-long-random-string

# The server's Stellar signing key (S...), used to co-sign SEP-10 challenge
# transactions. Leave empty to skip Stellar wallet auth.
STELLAR_SERVER_SECRET=

# Daily transaction limit for tier-0 accounts in the asset's smallest unit.
# Default: 500 USDC = 500 * 10_000_000 = 5_000_000_000 (7 decimal places).
TIER_0_DAILY_LIMIT_MINOR=5000000000

# Kobo per whole USDC used for Naira buy quotes (1 USDC = N kobo).
# Leave empty to disable buy quoting. Example: 150000 = ₦1,500 per USDC.
BUY_KOBO_PER_USDC=

# Fee on Naira buys in basis points (100 = 1%). Leave empty to disable quoting.
BUY_FEE_BPS=

# USDC withdrawal amounts at or above this value require a manual review step
# before they are submitted on-chain. Leave empty to never review automatically.
WITHDRAWAL_REVIEW_THRESHOLD_USDC=

# ── Stellar (engipay-chain) ───────────────────────────────────────────────────
# testnet or mainnet. Anything else is refused.
STELLAR_NETWORK=testnet
# Optional. Defaults to the Stellar Development Foundation's public Horizon.
STELLAR_HORIZON_URL=
# The custody account deposits arrive in (a plain G... address). Users get
# muxed M... addresses derived from it. Leave empty to skip Stellar.
STELLAR_CUSTODY_ACCOUNT=
# Optional: ledger to start watching from. Defaults to the latest ledger.
STELLAR_START_LEDGER=
# Seconds between Stellar polls. Defaults to 5.
STELLAR_POLL_SECONDS=5
# Only for `engipay-chain stellar-send`, and refused unless STELLAR_NETWORK=testnet.
# Never put a mainnet key here: production signing goes through a KMS.
STELLAR_TESTNET_SECRET=

# ── Base (engipay-chain) ──────────────────────────────────────────────────────
# mainnet or sepolia. Anything else is refused. Defaults to sepolia.
BASE_NETWORK=
# The Base JSON-RPC endpoint the deposit watcher polls for USDC transfers.
# BASE_RPC_URL and BASE_CUSTODY_ADDRESS must both be set (or both left empty).
BASE_RPC_URL=
# The custody address Base deposits arrive in (a plain 0x... address).
BASE_CUSTODY_ADDRESS=
# Optional: block to start watching from. Defaults to the last recorded block
# in chain_cursors, or the latest block on a first run.
BASE_START_BLOCK=
# Optional: seconds between polls. Defaults to 5.
BASE_POLL_SECONDS=5

# ── Bitcoin (engipay-chain) ───────────────────────────────────────────────────
# Esplora REST API used to watch for Bitcoin deposits and broadcast transactions.
# Example: https://blockstream.info/testnet/api
BITCOIN_ESPLORA_URL=
# The custody address Bitcoin deposits arrive in.
BITCOIN_CUSTODY_ADDRESS=

# ── Chain service HTTP interface ──────────────────────────────────────────────
# Address the chain service's internal HTTP server listens on.
# The API service calls this to request chain operations (e.g. withdrawals).
CHAIN_HTTP_ADDR=0.0.0.0:9090
# Address the chain service exposes for internal API calls. Defaults to the
# same value as CHAIN_HTTP_ADDR when this is left empty.
CHAIN_INTERNAL_ADDR=
# Shared secret the API service sends to authenticate internal requests.
# Required in production; set to a long random value.
CHAIN_INTERNAL_TOKEN=change-me-to-a-long-random-string

# ── Reconciliation (engipay-chain) ────────────────────────────────────────────
# Seconds between reconciliation runs. Defaults to 3600 (1 hour).
RECONCILE_INTERVAL_SECONDS=3600
# Maximum USDC surplus (in whole USDC) that reconciliation accepts without
# raising an alert. Leave empty to use the code default.
RECONCILE_SURPLUS_TOLERANCE=

# ── Naira ramp partner ────────────────────────────────────────────────────────
# Name of the active ramp partner (e.g. "flutterwave"). Leave empty to use
# the in-memory fake (dev/test only — never in production).
RAMP_PARTNER=
# HMAC-SHA256 signing secret shared with the ramp partner for webhook
# verification. Required when RAMP_PARTNER is set.
RAMP_WEBHOOK_SECRET=
