# Copy to backend/.env and fill in. backend/.env is git-ignored and must never be committed.

# Pick a long random value; this is only for the local database.
POSTGRES_USER=engipay
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=engipay

# Browser origins allowed to call the API, comma separated.
ALLOWED_ORIGINS=http://localhost:3000

# --- Stellar (engipay-chain) ---
# testnet or mainnet. Anything else is refused.
STELLAR_NETWORK=testnet
# Optional. Defaults to the Stellar Development Foundation's public Horizon.
STELLAR_HORIZON_URL=
# The custody account deposits arrive in (a plain G... address). Users get
# muxed M... addresses derived from it. Leave empty to skip Stellar.
STELLAR_CUSTODY_ACCOUNT=
# Optional: ledger to start watching from. Defaults to the latest ledger.
STELLAR_START_LEDGER=
# Only for `engipay-chain stellar-send`, and refused unless STELLAR_NETWORK=testnet.
# Never put a mainnet key here: production signing goes through a KMS.
STELLAR_TESTNET_SECRET=
